# Auth0 (required before using /auth/login)
# AUTH0_DOMAIN should be your tenant domain without https://, for example: your-tenant.us.auth0.com
AUTH0_DOMAIN=replace_with_your_auth0_tenant_domain
AUTH0_CLIENT_ID=replace_with_your_auth0_client_id
AUTH0_CLIENT_SECRET=replace_with_your_auth0_client_secret
AUTH0_SECRET=replace_with_a_real_32_plus_char_secret
# AUTH0_CLIENT_ID / AUTH0_CLIENT_SECRET must come from your Auth0 Regular Web Application.
# Do not use your Machine-to-Machine Management API app here.

# Local app URL used by Auth0 callbacks, logout redirects, and Google OAuth redirect URI
APP_BASE_URL=http://localhost:3000
# Optional public site URL for canonical/OG metadata (defaults to APP_BASE_URL)
# NEXT_PUBLIC_SITE_URL=https://life-os-five-iota.vercel.app

# Auth0 Management API credentials used by `npm run auth0:hosted-login` (optional)
# Use a Machine to Machine application with `update:prompts`, `read:connections`, and `update:connections`.
AUTH0_MANAGEMENT_CLIENT_ID=replace_with_your_management_client_id
AUTH0_MANAGEMENT_CLIENT_SECRET=replace_with_your_management_client_secret
AUTH0_HOSTED_LOGIN_TEXT=Log in to LifeOS to continue.
AUTH0_HOSTED_SIGNUP_TEXT=Log in to LifeOS to continue.
AUTH0_SOCIAL_CONNECTION_TO_DISABLE=google-oauth2

# ─── Google OAuth (required for Connect Gmail / Calendar / Drive) ───────────
# LifeOS uses direct Google OAuth (not Auth0 Token Vault).
# 1. Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Web Client
# 2. Authorized redirect URI: {APP_BASE_URL}/api/auth/google/callback
# 3. Enable Gmail API, Google Calendar API, Google Drive API, Google Docs API
# 4. OAuth consent screen: add required scopes + test users if app is in Testing
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret

# Convex
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
# CONVEX_DEPLOYMENT is usually written by `npx convex dev`

# AI - OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=your_openrouter_api_key
AI_MODEL=openai/gpt-4.1-mini
# Optional: cap model output tokens (default 2048, max 8192)
# AI_MAX_OUTPUT_TOKENS=2048

# Optional: allow mock Google tool responses without real tokens (local demos only)
# Never enable this in production.
# LIFEOS_DEMO_MODE=true
